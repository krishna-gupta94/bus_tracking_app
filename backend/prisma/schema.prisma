// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         String   @default("STUDENT")
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student       Student?
  driver        Driver?
  notifications Notification[]
  sosAlerts     SOSAlert[]

  @@map("users")
}

model Student {
  id          String @id @default(cuid())
  userId      String @unique
  studentCode String @unique

  courseStartYear       Int?
  courseEndYear         Int?
  accountExpirationDate DateTime?
  accountStatus         String    @default("ACTIVE")

  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedRoute   Route? @relation("StudentRoute", fields: [assignedRouteId], references: [id])
  assignedRouteId String?
  assignedStop    Stop?  @relation("StudentStop", fields: [assignedStopId], references: [id])
  assignedStopId  String?
  assignedBus     Bus?   @relation("StudentBus", fields: [assignedBusId], references: [id])
  assignedBusId   String?

  boardingEvents      BoardingEvent[]
  registrationRequest RegistrationRequest?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("students")
}

model Driver {
  id         String @id @default(cuid())
  userId     String @unique
  driverCode String @unique

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bus   Bus?
  trips Trip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("drivers")
}

model Bus {
  id                 String  @id @default(cuid())
  busNumber          String  @unique
  registrationNumber String  @unique
  capacity           Int
  status             String  @default("AVAILABLE")

  driver   Driver? @relation(fields: [driverId], references: [id])
  driverId String? @unique

  route   Route?  @relation(fields: [routeId], references: [id])
  routeId String?

  trips                Trip[]
  locations            BusLocation[]
  boardingEvents       BoardingEvent[]
  students             Student[]              @relation("StudentBus")
  registrationRequests RegistrationRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("buses")
}

model Route {
  id          String  @id @default(cuid())
  name        String
  description String?
  status      String  @default("ACTIVE")

  stops                Stop[]
  buses                Bus[]
  trips                Trip[]
  students             Student[]                 @relation("StudentRoute")
  historicalMetrics    HistoricalSegmentMetric[]
  boardingEvents       BoardingEvent[]
  registrationRequests RegistrationRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("routes")
}

model Stop {
  id        String  @id @default(cuid())
  name      String
  stopCode  String?
  address   String?
  latitude  Float
  longitude Float
  sequence  Int
  eta       String?
  status    String  @default("ACTIVE")

  route   Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  routeId String

  students             Student[]            @relation("StudentStop")
  registrationRequests RegistrationRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stops")
}

model Trip {
  id        String    @id @default(cuid())
  status    String    @default("ACTIVE")
  startTime DateTime  @default(now())
  endTime   DateTime?

  bus      Bus    @relation(fields: [busId], references: [id])
  busId    String

  driver   Driver @relation(fields: [driverId], references: [id])
  driverId String

  route   Route  @relation(fields: [routeId], references: [id])
  routeId String

  locations      BusLocation[]
  boardingEvents BoardingEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("trips")
}

model BusLocation {
  id        String   @id @default(cuid())
  latitude  Float
  longitude Float
  speed     Float?   // Speed in km/h
  heading   Float?   // Bearing in degrees
  accuracy  Float?   // Accuracy in meters
  timestamp DateTime @default(now())

  trip   Trip   @relation(fields: [tripId], references: [id])
  tripId String

  bus   Bus    @relation(fields: [busId], references: [id])
  busId String

  @@index([busId, timestamp])
  @@map("bus_locations")
}

model HistoricalSegmentMetric {
  id                String   @id @default(cuid())
  routeId           String
  fromStopId        String?
  toStopId          String
  dayOfWeek         Int      // 0 = Sunday, 1 = Monday, ... 6 = Saturday
  hourOfDay         Int      // 0 - 23
  distanceMeters    Float
  travelTimeSeconds Float    // Moving average of segment transit duration
  averageSpeedKmh   Float
  sampleCount       Int      @default(1)
  updatedAt         DateTime @updatedAt

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, toStopId, dayOfWeek, hourOfDay])
  @@index([routeId, toStopId])
  @@map("historical_segment_metrics")
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@map("notifications")
}

model BoardingEvent {
  id                 String    @id @default(cuid())
  studentId          String
  busId              String?
  tripId             String?
  routeId            String
  stopId             String?

  // === Core Detection Fields (preserved) ===
  status             String    @default("UNKNOWN")
  // Valid: PENDING_CONFIRMATION | STUDENT_CONFIRMED | STUDENT_DECLINED
  //        | GPS_LIKELY_BOARDED | CONFLICT
  //        | BOARDED_CONFIRMED | NOT_BOARDED_CONFIRMED
  //        | NO_RESPONSE | VERIFICATION_INCOMPLETE | UNKNOWN
  //        | BOARDED_ASSIGNED_ROUTE_BUS | BOARDED_OTHER_ROUTE_BUS  (legacy)
  //        | LIKELY_BOARDED | NOT_BOARDED  (legacy)
  confidence         Int       @default(0)         // 0 - 100
  detectedBusNumber  String?
  notes              String?
  verifiedAt         DateTime?

  // === Student Response Tracking ===
  studentResponse    String?   // 'YES' | 'NO' | null (no response)
  respondedAt        DateTime? // When student tapped YES/NO

  // === GPS Inference (separate from student response) ===
  gpsInference       String?   // 'LIKELY_BOARDED' | 'NOT_BOARDED' | 'INSUFFICIENT_DATA'
  gpsConfidence      Int       @default(0) // 0-100, GPS-only confidence score
  gpsEvidenceSummary String?   // Human-readable: "Moved 2.1km with bus over 180s, heading ±12°"

  // === Confirmation Source ===
  confirmationSource String?   // 'STUDENT_YES' | 'STUDENT_NO_GPS_AGREE' | 'ADMIN_REVIEW'
                               // | 'GPS_AUTO' | 'NO_RESPONSE_GPS' | 'STUDENT_NO_GPS_INCONCLUSIVE'
                               // | 'VERIFICATION_INCOMPLETE'

  // === Admin Resolution ===
  resolvedBy         String?   // Admin user.id who resolved a CONFLICT
  resolvedAt         DateTime? // When admin resolved
  previousStatus     String?   // Status before admin override (audit trail)

  // === Verification Window ===
  verificationExpiresAt DateTime? // When post-decline GPS monitoring ends

  // === Dedup Key (strict: requires tripId + busId + stopId all non-null) ===
  eventKey           String?   @unique
  // Format: "s:{studentId}:t:{tripId}:b:{busId}:st:{stopId}"
  // Set on create only, never mutated.

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  bus     Bus?    @relation(fields: [busId], references: [id], onDelete: SetNull)
  trip    Trip?   @relation(fields: [tripId], references: [id], onDelete: SetNull)
  route   Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([routeId, createdAt])
  @@index([busId, createdAt])
  @@index([status, createdAt])
  @@map("boarding_events")
}

model SOSAlert {
  id              String    @id @default(cuid())
  userId          String
  userName        String
  userRole        String    // STUDENT | DRIVER
  studentCode     String?
  driverCode      String?
  busNumber       String?
  routeName       String?
  stopName        String?
  latitude        Float?
  longitude       Float?
  locationAddress String?
  status          String    @default("NEW") // NEW | ACKNOWLEDGED | RESOLVED
  severity        String    @default("CRITICAL") // CRITICAL | HIGH | WARNING
  note            String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("sos_alerts")
}

model RegistrationRequest {
  id              String @id @default(cuid())

  // Student info (NO password field)
  name            String
  studentCode     String
  email           String
  phone           String?
  courseStartYear Int
  courseEndYear   Int

  // Validated selection IDs
  routeId String
  busId   String
  stopId  String

  // Document storage paths in Supabase Storage (student-documents bucket, private)
  // Path pattern: registrations/{requestId}/college-id.{ext}
  collegeIdPath String?
  busSlipPath   String?

  // Supabase Auth bridge (temporary — deleted after account activation or rejection)
  supabaseAuthId String? @unique // auth.users.id UUID

  // Email verification (set by backend via Supabase Admin API poll / webhook)
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?

  // Registration lifecycle status
  // EMAIL_VERIFICATION_PENDING | PENDING_ADMIN_REVIEW | APPROVED | REJECTED
  status String @default("EMAIL_VERIFICATION_PENDING")

  // Admin review
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?

  // Password-setup token (set at approval — raw token sent in email, NEVER stored)
  passwordSetupTokenHash   String?   // SHA-256 of raw token
  passwordSetupTokenExpiry DateTime?
  passwordSetupUsed        Boolean   @default(false)

  // Linked student (set when student completes password setup)
  approvedStudentId String? @unique

  // Relations
  route           Route    @relation(fields: [routeId], references: [id])
  bus             Bus      @relation(fields: [busId], references: [id])
  stop            Stop     @relation(fields: [stopId], references: [id])
  approvedStudent Student? @relation(fields: [approvedStudentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([studentCode])
  @@index([status, createdAt])
  @@index([supabaseAuthId])
  @@map("registration_requests")
}
