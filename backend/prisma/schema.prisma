generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  phone         String?
  passwordHash  String
  role          String         @default("STUDENT")
  status        String         @default("ACTIVE")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  driver        Driver?
  notifications Notification[]
  sosAlerts     SOSAlert[]
  student       Student?

  @@map("users")
}

model Student {
  id                    String               @id @default(cuid())
  userId                String               @unique
  studentCode           String               @unique
  courseStartYear       Int?
  courseEndYear         Int?
  accountExpirationDate DateTime?
  accountStatus         String               @default("ACTIVE")
  assignedRouteId       String?
  assignedStopId        String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  assignedBusId         String?
  boardingEvents        BoardingEvent[]
  registrationRequest   RegistrationRequest?
  assignedBus           Bus?                 @relation("StudentBus", fields: [assignedBusId], references: [id])
  assignedRoute         Route?               @relation("StudentRoute", fields: [assignedRouteId], references: [id])
  assignedStop          Stop?                @relation("StudentStop", fields: [assignedStopId], references: [id])
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("students")
}

model Driver {
  id         String   @id @default(cuid())
  userId     String   @unique
  driverCode String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  bus        Bus?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trips      Trip[]

  @@map("drivers")
}

model Bus {
  id                   String                @id @default(cuid())
  busNumber            String                @unique
  registrationNumber   String                @unique
  capacity             Int
  status               String                @default("AVAILABLE")
  driverId             String?               @unique
  routeId              String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  boardingEvents       BoardingEvent[]
  locations            BusLocation[]
  driver               Driver?               @relation(fields: [driverId], references: [id])
  route                Route?                @relation(fields: [routeId], references: [id])
  registrationRequests RegistrationRequest[]
  students             Student[]             @relation("StudentBus")
  trips                Trip[]

  @@map("buses")
}

model Route {
  id                   String                    @id @default(cuid())
  name                 String
  description          String?
  status               String                    @default("ACTIVE")
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  boardingEvents       BoardingEvent[]
  buses                Bus[]
  historicalMetrics    HistoricalSegmentMetric[]
  registrationRequests RegistrationRequest[]
  stops                Stop[]
  students             Student[]                 @relation("StudentRoute")
  trips                Trip[]

  @@map("routes")
}

model Stop {
  id                   String                @id @default(cuid())
  name                 String
  stopCode             String?
  address              String?
  latitude             Float
  longitude            Float
  sequence             Int
  eta                  String?
  status               String                @default("ACTIVE")
  routeId              String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  registrationRequests RegistrationRequest[]
  route                Route                 @relation(fields: [routeId], references: [id], onDelete: Cascade)
  students             Student[]             @relation("StudentStop")

  @@map("stops")
}

model Trip {
  id             String          @id @default(cuid())
  status         String          @default("ACTIVE")
  startTime      DateTime        @default(now())
  endTime        DateTime?
  busId          String
  driverId       String
  routeId        String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  boardingEvents BoardingEvent[]
  locations      BusLocation[]
  bus            Bus             @relation(fields: [busId], references: [id])
  driver         Driver          @relation(fields: [driverId], references: [id])
  route          Route           @relation(fields: [routeId], references: [id])

  @@map("trips")
}

model BusLocation {
  id        String   @id @default(cuid())
  latitude  Float
  longitude Float
  speed     Float?
  heading   Float?
  accuracy  Float?
  timestamp DateTime @default(now())
  tripId    String
  busId     String
  bus       Bus      @relation(fields: [busId], references: [id])
  trip      Trip     @relation(fields: [tripId], references: [id])

  @@index([busId, timestamp])
  @@map("bus_locations")
}

model HistoricalSegmentMetric {
  id                String   @id @default(cuid())
  routeId           String
  fromStopId        String?
  toStopId          String
  dayOfWeek         Int
  hourOfDay         Int
  distanceMeters    Float
  travelTimeSeconds Float
  averageSpeedKmh   Float
  sampleCount       Int      @default(1)
  updatedAt         DateTime @updatedAt
  route             Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, toStopId, dayOfWeek, hourOfDay])
  @@index([routeId, toStopId])
  @@map("historical_segment_metrics")
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model BoardingEvent {
  id                    String    @id @default(cuid())
  studentId             String
  busId                 String?
  tripId                String?
  routeId               String
  stopId                String?
  status                String    @default("UNKNOWN")
  confidence            Int       @default(0)
  detectedBusNumber     String?
  notes                 String?
  verifiedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  confirmationSource    String?
  eventKey              String?   @unique
  gpsConfidence         Int       @default(0)
  gpsEvidenceSummary    String?
  gpsInference          String?
  previousStatus        String?
  resolvedAt            DateTime?
  resolvedBy            String?
  respondedAt           DateTime?
  studentResponse       String?
  verificationExpiresAt DateTime?
  bus                   Bus?      @relation(fields: [busId], references: [id])
  route                 Route     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  student               Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  trip                  Trip?     @relation(fields: [tripId], references: [id])

  @@index([studentId, createdAt])
  @@index([routeId, createdAt])
  @@index([busId, createdAt])
  @@index([status, createdAt])
  @@map("boarding_events")
}

model SOSAlert {
  id              String    @id @default(cuid())
  userId          String
  userName        String
  userRole        String
  studentCode     String?
  driverCode      String?
  busNumber       String?
  routeName       String?
  stopName        String?
  latitude        Float?
  longitude       Float?
  locationAddress String?
  status          String    @default("NEW")
  severity        String    @default("CRITICAL")
  note            String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("sos_alerts")
}

model RegistrationRequest {
  id                  String    @id @default(cuid())
  name                String
  studentCode         String
  email               String
  phone               String?
  courseStartYear     Int
  courseEndYear       Int
  routeId             String
  busId               String
  stopId              String
  collegeIdPath       String?
  busSlipPath         String?
  status              String    @default("PENDING")
  reviewedById        String?
  reviewedAt          DateTime?
  rejectionReason     String?
  approvedStudentId   String?   @unique
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  busSlipName         String?
  busSlipSize         Int?
  busSlipType         String?
  busSlipUploadedAt   DateTime?
  collegeIdName       String?
  collegeIdSize       Int?
  collegeIdType       String?
  collegeIdUploadedAt DateTime?
  passwordHash        String    @default("")
  approvedStudent     Student?  @relation(fields: [approvedStudentId], references: [id])
  bus                 Bus       @relation(fields: [busId], references: [id])
  route               Route     @relation(fields: [routeId], references: [id])
  stop                Stop      @relation(fields: [stopId], references: [id])

  @@index([email])
  @@index([studentCode])
  @@index([status, createdAt])
  @@map("registration_requests")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}
